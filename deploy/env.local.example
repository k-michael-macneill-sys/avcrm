# Local development environment. Copy to .env and run with:
#   docker compose -f docker-compose.yml -f deploy/compose.local.yml up -d --build

# --- required by the base compose, even if Caddy doesn't run locally ---
DOMAIN=localhost
ACME_EMAIL=dev@localhost

APP_BASE_URL=http://localhost:3000

# --- database ---
POSTGRES_USER=avcrm
POSTGRES_DB=avcrm
POSTGRES_PASSWORD=dev-password-only
DATABASE_URL=postgres://avcrm:dev-password-only@postgres:5432/avcrm

# --- secrets ---
JWT_SECRET=dev-jwt-secret-at-least-32-characters-long-thats-why-im-long
SECRETS_KEY=dev-secrets-key-at-least-48-characters-which-is-why-this-is-so-long

# --- mail ---
MAIL_DRIVER=log
MAIL_FROM=Drift <dev@localhost>
MAIL_REPLY_TO=dev@localhost

# --- payments ---
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=cad

# --- the rest ---
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_PLACE_ID/review
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
