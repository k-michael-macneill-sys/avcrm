# TLS is automatic: Caddy gets a certificate from Let's Encrypt on first boot
# and renews it. The only requirements are that DOMAIN resolves to this
# machine and that ports 80 and 443 reach it.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# The upload endpoint takes phone photos, and the default 100MB is more
	# than the largest purpose allows anyway — the application does the real
	# refusing, with a message.
	request_body {
		max_size 30MB
	}

	# Content-Security-Policy, HSTS and the rest are the app's own (see
	# src/middleware/securityHeaders.ts), so a deploy without Caddy — Render —
	# sends the same ones. Setting them here as well would overwrite the app's
	# per-page policies: the pay page loads Square's card form and the leads
	# map loads Google Maps, and a blanket policy here would block both.
	header {
		-Server
	}

	reverse_proxy app:3000
}
