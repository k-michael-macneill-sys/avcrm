# Production environment. Copy to .env beside docker-compose.yml and fill in.
#
#   cp deploy/env.example .env
#
# This file holds every secret the system has. It is not in git, it should be
# owned by root with mode 600, and it is the thing to back up alongside the
# database — losing SECRETS_KEY makes the stored SMS credentials unreadable.

# --- the machine ----------------------------------------------------------
# Must already resolve to this server: Caddy asks Let's Encrypt for a
# certificate on first boot and that check is a real HTTP request.
DOMAIN=crm.example.ca
ACME_EMAIL=office@example.ca

# Where customer-facing links point. Card-setup links and review links are
# built from this, so it has to be the public address, with https.
APP_BASE_URL=https://crm.example.ca

# --- database -------------------------------------------------------------
POSTGRES_USER=avcrm
POSTGRES_DB=avcrm
# openssl rand -base64 24
POSTGRES_PASSWORD=
# The host is the compose service name, not localhost.
DATABASE_URL=postgres://avcrm:PASSWORD_FROM_ABOVE@postgres:5432/avcrm

# --- secrets --------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
# Encrypts the SMS provider credentials an administrator saves in Settings.
# Optional — without it the key is derived from JWT_SECRET, which works but
# means rotating JWT_SECRET makes those credentials unreadable.
SECRETS_KEY=

# --- mail -----------------------------------------------------------------
# Any provider: Postmark, SES, Mailgun and SendGrid all issue SMTP
# credentials. Leave MAIL_DRIVER=log and nothing is sent.
MAIL_DRIVER=smtp
MAIL_FROM=Avalanche <billing@example.ca>
MAIL_REPLY_TO=office@example.ca
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# On a staging copy of production, set this and no customer is ever emailed.
#MAIL_REDIRECT_TO=staging@example.ca

# --- payments -------------------------------------------------------------
# `manual` records what a processor or a cheque says happened. `stripe`
# actually charges saved cards, and needs both keys.
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=cad
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=

# --- text messages --------------------------------------------------------
# The provider itself is not configured here — an administrator connects one
# in Settings, so changing it needs no redeploy. This is the staging valve.
#SMS_REDIRECT_TO=+19025550123

# --- the rest -------------------------------------------------------------
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_PLACE_ID/review
LOG_LEVEL=info
# Kept for a fortnight on the box. See deploy/backup.sh about getting them off
# it, which is the half that matters.
BACKUP_KEEP_DAYS=14
