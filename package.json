{
  "name": "avcrm",
  "version": "0.1.0",
  "private": true,
  "description": "Snow and ice removal CRM - API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:rollback",
    "migrate:make": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts --migrations-directory migrations migrate:make -x ts",
    "seed": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts seed:run",
    "knex": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts",
    "migrate:status": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:status",
    "job:document-expiry": "tsx src/jobs/documentExpiry.ts",
    "job:message-queue": "tsx src/jobs/messageQueue.ts",
    "job:review-requests": "tsx src/jobs/reviewRequests.ts",
    "job:billing": "tsx src/jobs/billing.ts",
    "build:api": "tsc",
    "build:web": "vite build --config client/vite.config.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "test": "bash scripts/test-setup.sh",
    "test:watch": "bash scripts/test-setup.sh --watch",
    "job:scheduler": "tsx src/jobs/scheduler.ts",
    "secrets": "tsx src/ops/secrets.ts",
    "preflight": "tsx src/ops/preflight.ts",
    "bootstrap": "tsx src/ops/bootstrap.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lucide-react": "^0.445.0",
    "nodemailer": "^10.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "pino-pretty": "^11.2.1",
    "postcss": "^8.5.28",
    "smtp-server": "^3.19.10",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.21"
  }
}
