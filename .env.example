# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://avcrm:avcrm@localhost:5432/avcrm
# Set to true when connecting to a managed Postgres that requires TLS.
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-every-environment-at-least-32-chars
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Seeds (dev only). Applied by `npm run seed`.
SEED_PASSWORD=Password123!
