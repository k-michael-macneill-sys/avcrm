# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Express `trust proxy`. Contracts record the IP the signature came from, so
# set this behind a load balancer (true, a hop count, or a list of addresses)
# or every contract is stamped with the proxy's address.
TRUST_PROXY=false

# Database
DATABASE_URL=postgres://avcrm:avcrm@localhost:5432/avcrm
# Set to true when connecting to a managed Postgres that requires TLS.
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=Awk8clQl5efZ00FW9OSwOgcki1Z4WjxT
JWT_EXPIRES_IN=120h
BCRYPT_ROUNDS=10

# Outbound mail
# `log` writes to the application log and needs no mail server, which is the
# right default for development and for the test suite. `smtp` is a real
# transport; Postmark, SES, Mailgun and SendGrid all give you SMTP
# credentials, so this one driver covers any of them.
MAIL_DRIVER=log
MAIL_FROM="Avalanche CRM <no-reply@example.test>"
#MAIL_REPLY_TO=office@example.test
# Safety valve: send everything to one inbox instead of to customers. Set this
# in staging, which is usually a copy of production with real addresses in it.
#MAIL_REDIRECT_TO=staging@example.test

#SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=

# Text messages
# The provider itself is not configured here — a corporate user connects one
# at /app/settings, so changing it needs no redeploy. These two are
# environment-level rather than company-level.
# Sends every text here instead of to the customer. Staging is a copy of
# production, real phone numbers and all.
#SMS_REDIRECT_TO=+19025550123
# Only for pointing the driver at a stand-in. Leave unset in production.
#SMS_API_BASE=http://127.0.0.1:12222

# Encrypts the provider credentials saved in the settings screen. Optional:
# without it the key is derived from JWT_SECRET, which works but means
# rotating JWT_SECRET makes those credentials unreadable.
#SECRETS_KEY=6FNaDXhAOlqrV8ImlRAJG4V9HQmPvcwi

# Taking payments
# `manual` records what a processor (or a rep with a cheque) says happened.
# `stripe` actually charges saved cards. Both secrets are required for stripe:
# without the webhook secret we would take money and never hear how it went.
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=cad
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
# Only for pointing the SDK at stripe-mock or the local stand-in.
#STRIPE_API_HOST=127.0.0.1
#STRIPE_API_PORT=12111
#STRIPE_API_PROTOCOL=http

# Object storage
# `local` writes under STORAGE_LOCAL_DIR and needs no credentials. A bucket
# driver plugs in behind the same interface — see the README.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# How long an issued upload target stays usable.
UPLOAD_URL_TTL_SECONDS=900

# Outbound messaging
# Base URL for customer-facing links (the one-tap review rating, for example).
APP_BASE_URL=http://localhost:3000
# Where a 4-5 star rating sends the customer.
GOOGLE_REVIEW_URL=https://g.page/r/example/review
# Retries before the queue worker gives up on a message.
MESSAGE_MAX_ATTEMPTS=3

# Seeds (dev only). Applied by `npm run seed`.
SEED_PASSWORD=Password123!
