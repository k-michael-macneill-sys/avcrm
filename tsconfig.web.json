{
  "compilerOptions": {
    "target": "ES2022",
    // Native browser modules: no bundler anywhere in this project, so tsc
    // emits what the browser loads. Imports carry explicit .js extensions
    // because tsc does not rewrite specifiers.
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // rootDir is the repo so web/ can share src/types/models.ts with the
    // API — the same row shapes and status tuples, one definition.
    "rootDir": ".",
    "outDir": "public/assets",
    // No @types/node here: this code runs in a browser.
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["web/**/*.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
